<tool id="zooma" name="ZOOMA annotate/map" version="@TOOL_VERSION@+galaxy@GALAXY_VERSION@" profile="25.1">
    <description>Map or annotate tabular values using ZOOMA</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="creator"/>

    <requirements>
        <requirement type="package" version="2.32.3">requests</requirement>
    </requirements>

    <command detect_errors="aggressive"><![CDATA[
        python '$__tool_directory__/zooma.py'
            --input '$input'
            --output '$output'
            --column '$query_column'
            --mode '$mode'
            #if str($mode) == 'map'
            --api-url 'https://www.ebi.ac.uk/spot/zooma/v3/api/services/map'
            #else
            --api-url 'https://www.ebi.ac.uk/spot/zooma/v2/api/services/annotate'
            #end if
            --health-url 'https://www.ebi.ac.uk/spot/zooma/v3/api/health'
            --timeout '60'
            --batch-size '$batch_size'
            --ontology-filter '$ontology_filter.filter_type'
            #if str($ontology_filter.filter_type) == 'custom'
            --ontologies '$ontology_filter.ontologies'
            #end if
    ]]></command>

    <inputs>
        <param name="input" type="data" format="tabular,tsv,txt" label="Input table" help="Tabular dataset with one query term per row. The first row is treated as header and skipped by the wrapper." />
        <param name="query_column" type="data_column" data_ref="input" use_header_names="true" label="Column used for ZOOMA query" help="Choose the text column whose values should be sent to ZOOMA (for example compound names, phenotypes, or free-text labels). Empty cells are ignored." />
        <param name="mode" type="select" label="ZOOMA operation mode" help="Select how ZOOMA should process each value: Annotate uses the legacy curated annotate API, while Map uses the newer v3 term mapping API with ontology candidates.">
            <option value="annotate">Annotate (legacy endpoint)</option>
            <option value="map" selected="true">Map (v3 endpoint)</option>
        </param>
        <param name="batch_size" type="integer" value="10" min="1" max="100" label="Batch size" help="Number of query values to send per API call. Reduce if you experience timeouts." />
        <conditional name="ontology_filter">
            <param name="filter_type" type="select" label="Ontology filter" help="Select which ontologies should be used for mapping results, similar to the ZOOMA web GUI.">
                <option value="all" selected="true">All ontologies</option>
                <option value="efo_obo">EFO and OBO foundry ontologies</option>
                <option value="obo">OBO foundry ontologies only</option>
                <option value="custom">Custom ontology selection</option>
            </param>
            <when value="all" />
            <when value="efo_obo" />
            <when value="obo" />
            <when value="custom">
                <param name="ontologies" type="select" label="Select ontologies" help="Choose specific ontologies to include. More ontologies will be added in a future release." multiple="true">
                    <option value="efo">EFO (Experimental Factor Ontology)</option>
                    <option value="obo">OBO Foundry</option>
                </param>
            </when>
        </conditional>
    </inputs>

    <outputs>
        <data name="output" format="tabular" />
    </outputs>

    <tests>
        <test>
            <param name="input" value="input.tsv" ftype="tabular" />
            <param name="query_column" value="1" />
            <output name="output" ftype="tabular">
                <assert_contents>
                    <has_n_lines n="150" delta="50"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help><![CDATA[
        @HELP@
    ]]></help>

    <citations>
        <citation type="doi">10.5281/zenodo.6035335</citation>
    </citations>
</tool>
