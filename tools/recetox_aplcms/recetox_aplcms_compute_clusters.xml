<tool id="recetox_aplcms_compute_clusters" name="recetox-aplcms - compute clusters" version="@TOOL_VERSION@+galaxy0" profile="23.0">
    <description>compute clusters of mz and rt across samples and assign cluster IDs to individual features</description>
    <macros>
        <import>macros.xml</import>
        <import>help.xml</import>
    </macros>
    <expand macro="annotation"/>
    <edam_operations>
        <edam_operation>operation_2928</edam_operation>
    </edam_operations>
    <expand macro="refs"/>
    <expand macro="creator"/>
    <expand macro="requirements"/>

    <command detect_errors="aggressive"><![CDATA[
        Rscript -e 'source("${__tool_directory__}/utils.R")' -e 'source("${run_script}")'
    ]]></command>
    <configfiles>
         <configfile name="run_script"><![CDATA[
         
              #set filenames = str("', '").join([str($f) for $f in $files])
              feature_tables <- load_parquet_collection(c('$filenames'))
              sample_names <- laad_sample_id(feature_table)

              message(sprintf("Loaded %d sample names", length(sample_names)))
              message(paste("sample_names:", paste(sample_names, collapse = ", ")))

              validate_sample_names(sample_names)

              ordering <- order(sample_names)
              feature_tables <- feature_tables[ordering]
              sample_names <- sample_names[ordering]

              clusters <- compute_clusters_simple(
                  feature_tables = feature_tables,
                  sample_names = sample_names,
                  mz_tol_ppm = $mz_tol_relative_ppm,
                  rt_tol = $rt_tol
              )

              sample_names <- unlist(lapply(clusters, restore_sample_name))

              message(sprintf("Changed %d sample names", length(sample_names)))
              message(paste("sample_names:", paste(sample_names, collapse = ", ")))

              save_parquet_collection(clusters, sample_names, "clustered")
         ]]></configfile>
    </configfiles>

    <inputs>
        <param name="files" type="data_collection" collection_type="list" format="parquet" label="Input data"
               help="List of tables containing features." />
        <expand macro="tolerances"/>
    </inputs>

    <outputs>
        <collection name="clustered_feature_tables" type="list"
                    label="${tool.name} feature_tables on ${on_string}">
            <discover_datasets pattern="__designation__" directory="clustered" format="parquet" />
        </collection>
    </outputs>

    <tests>
        <test expect_num_outputs="1">
            <param name="files">
                <collection type="list">
                  <element name="8_qc_no_dil_milliq.mzml.parquet" location="https://github.com/RECETOX/recetox-aplcms/tree/master/tests/testdata/extracted/8_qc_no_dil_milliq.mzml.parquet" ftype = "parquet"/>
                  <element name="21_qc_no_dil_milliq.mzml.parquet" location="https://github.com/RECETOX/recetox-aplcms/tree/master/tests/testdata/extracted/21_qc_no_dil_milliq.mzml.parquet" ftype = "parquet"/>
                  <element name="29_qc_no_dil_milliq.mzml.parquet" location="hhttps://github.com/RECETOX/recetox-aplcms/tree/master/tests/testdata/extracted/29_qc_no_dil_milliq.mzml.parquet" ftype = "parquet"/>
                </collection>
            </param> 
            <output_collection name="clustered_feature_tables" type="list">
                <assert_contents>
                <!-- ??????????? -->
                    <has_n_elements_with_path n="9" path="BlastOutput_iterations/Iteration/Iteration_hits/Hit/Hit_num" />
                    <!-- change size! -->
                    <has_size size="10k"/>
                </assert_contents>
            </output_collection>
        </test>
    </tests>

    <help>
        <![CDATA[
            @COMPUTE_CLUSTERS_HELP@

            @GENERAL_HELP@
        ]]>
    </help>

    <expand macro="citations"/>
</tool>
