<tool id="recetox_aplcms_compute_template" name="recetox-aplcms - compute template" version="@TOOL_VERSION@+galaxy0" profile="23.0">
    <description>compute retention time correction template feature table</description>
    <macros>
        <import>macros.xml</import>
        <import>help.xml</import>
    </macros>
    <expand macro="annotation"/>
    <edam_operations>
        <edam_operation>operation_3936</edam_operation>
    </edam_operations>
    <expand macro="refs"/>
    <expand macro="creator"/>
    <expand macro="requirements"/>

    <command detect_errors="aggressive"><![CDATA[
        Rscript -e 'source("${__tool_directory__}/utils.R")' -e 'source("${run_script}")'
    ]]></command>
    <configfiles>
         <configfile name="run_script"><![CDATA[
              #set filenames = str("', '").join([str($f) for $f in $files])
              feature_tables <- load_parquet_collection(c('$filenames'))

              template_features <- compute_template(feature_tables)

              save_data_as_parquet_file(template_features, '$output_file')
         ]]></configfile>
    </configfiles>

    <inputs>
        <param name="files" type="data_collection" collection_type="list" format="parquet" label="Input data"
               help="Table containing clustered features." />
    </inputs>

    <outputs>
        <data label="${tool.name} on ${on_string}" name="output_file" format="parquet" />
    </outputs>

    <tests>
        <test expect_num_outputs="1">
            <param name="files">
                <collection type="list">
                  <element name="RCX_06_shortened_extracted_clusters.parquet" location="https://github.com/RECETOX/recetox-aplcms/tree/master/tests/testdata/clusters/RCX_06_shortened_extracted_clusters.parquet" ftype = "parquet"/>
                  <element name="RCX_07_shortened_extracted_clusters.parquet" location="https://github.com/RECETOX/recetox-aplcms/tree/master/tests/testdata/clusters/RCX_07_shortened_extracted_clusters.parquet" ftype = "parquet" />
                  <element name="RCX_08_shortened_extracted_clusters.parquet" location="https://github.com/RECETOX/recetox-aplcms/tree/master/tests/testdata/clusters/RCX_08_shortened_extracted_clusters.parquet" ftype = "parquet" />
                </collection>
            </param> 
            <output name="output_file"> 
                <assert_contents>
                    <!-- change size! -->
                    <has_size size="10k" />  
                </assert_contents>
            </output>
        </test>
    </tests>
    
    <help>
        <![CDATA[
            @COMPUTE_TEMPLATE_HELP@

            @GENERAL_HELP@
            
        ]]>
    </help>

    <expand macro="citations"/>
</tool>
