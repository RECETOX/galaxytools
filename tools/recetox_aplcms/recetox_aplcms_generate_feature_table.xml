<tool id="recetox_aplcms_generate_feature_table" name="recetox-aplcms - generate feature table" version="@TOOL_VERSION@+galaxy0" profile="23.0">
    <description>generate feature table from noise-removed HRMS profile data</description>
    <macros>
        <import>macros.xml</import>
        <import>help.xml</import>
    </macros>
    <expand macro="annotation"/>
    <edam_operations>
        <edam_operation>operation_3215</edam_operation>
        <edam_operation>operation_3799</edam_operation>
    </edam_operations>
    <expand macro="refs"/>
    <expand macro="creator"/>
    <expand macro="requirements"/>

    <command detect_errors="aggressive"><![CDATA[
        Rscript -e 'source("${__tool_directory__}/utils.R")' -e 'source("${run_script}")'
    ]]></command>
    <configfiles>
         <configfile name="run_script"><![CDATA[
             profile <- load_data_from_parquet_file('$profile')
             sample_name <- load_sample_id(profile)

             message(paste("sample_name:", paste(sample_name, collapse = ", ")))

             if(is.na(sample_name)) {
                 message("The file does not contain sample name.")
             }

             feature_table <- prof.to.features(
                 profile = profile,
                 bandwidth = $bandwidth,
                 #if $min_bandwidth:
                 min_bandwidth = $min_bandwidth,
                 #else:
                 min_bandwidth = NA,
                 #end if
                 #if $max_bandwidth:
                 max_bandwidth = $max_bandwidth,
                 #else:
                 max_bandwidth = NA,
                 #end if
                 #if $advanced.sd_cut.sd_cut_bounds == "TRUE":
                 sd_cut = c($advanced.sd_cut.sd_cut_min, $advanced.sd_cut.sd_cut_max),
                 #else
                 sd_cut = c(0, Inf),
                 #end if
                 sigma_ratio_lim = determine_sigma_ratios($advanced.shape_model_param.sigma_ratio_lim_min, $advanced.shape_model_param.sigma_ratio_lim_max),
                 shape_model = "$shape_model",
                 peak_estim_method = "$advanced.peak_estim.peak_estim_method",
                 component_eliminate = $advanced.component_eliminate,
                 #if $advanced.peak_estim.peak_estim_method == "moment":
                 moment_power = $advanced.peak_estim.moment_power,
                 #else
                 moment_power = 1,
                 #end if
                 BIC_factor = $BIC_factor,
                 do.plot = FALSE
             )

             save_data_as_parquet_file(feature_table, '$output_file')
         ]]></configfile>
    </configfiles>

    <inputs>
        <param label="Input profile data" name="profile" type="data" format="parquet"
               help="Mass spectrometry profile data." />
        <expand macro="bandwidth_params"/>
        <expand macro="generate_feature_table_params"/>
    </inputs>

    <outputs>
        <data label="${($profile.element_identifier).rsplit('.',1)[0]}.parquet" name="output_file" format="parquet" />
    </outputs>

    <tests>
        <test>
        <!-- #mbr_test0 -->
            <param name="profile" location="https://media.githubusercontent.com/media/RECETOX/recetox-aplcms/master/tests/testdata/filtered/mbr_test0.parquet" ftype="parquet" />
            <section name="advanced">
                <conditional name="sd_cut">
                    <param name="sd_cut_bounds" value="TRUE"/>
                    <param name="sd_cut_min" value="0.1"/>
                    <param name="sd_cut_max" value="100"/>
                </conditional>
            
                <section name="shape_model_param">
                    <param name="sigma_ratio_lim_min" value="0.1"/>
                    <param name="sigma_ratio_lim_max" value="10"/>
                </section>
            </section>
            <output name="output_file"> 
                <assert_contents>
                    <has_size size="2232"/>
                </assert_contents>
            </output>
        </test>

        <test>
        <!-- thermo.raw -->
            <param name="profile" location="https://media.githubusercontent.com/media/RECETOX/recetox-aplcms/master/tests/testdata/filtered/thermo_raw_profile.parquet" ftype="parquet" />
            <param name="shape_model" value="Gaussian" />
            <section name="advanced">
                <conditional name="sd_cut">
                    <param name="sd_cut_bounds" value="TRUE"/>
                    <param name="sd_cut_min" value="0.1"/>
                    <param name="sd_cut_max" value="1"/>
                </conditional>
            </section>
            <output name="output_file"> 
                <assert_contents>
                    <has_size size="64508"/>
                </assert_contents>
            </output>
        </test>

        <test> 
        <!-- #RCX_06_shortened_gaussian -->
            <param name="profile" location="https://media.githubusercontent.com/media/RECETOX/recetox-aplcms/master/tests/testdata/filtered/RCX_06_shortened.parquet" ftype="parquet" />
            <param name="shape_model" value="Gaussian" />
            <section name="advanced">
                <conditional name="sd_cut">
                    <param name="sd_cut_bounds" value="TRUE"/>
                    <param name="sd_cut_min" value="0.01"/>
                    <param name="sd_cut_max" value="500"/>
                </conditional>

                <section name="shape_model_param">
                    <param name="sigma_ratio_lim_min" value="0.01"/>
                    <param name="sigma_ratio_lim_max" value="100"/>
                </section>
            </section>
            <output name="output_file"> 
                <assert_contents>
                    <has_size size="649887"/>
                </assert_contents>
            </output>
        </test>
    </tests>

    <help>
        <![CDATA[
            @GENERATE_FEATURE_TABLE_HELP@

            @GENERAL_HELP@
        ]]>
    </help>

    <expand macro="citations"/>
</tool>
