    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        mkdir -p 'files' &&
        #for $f in $input_files:
            ln -s '${f}' 'files/${f.element_identifier}.${f.ext}' &&
        #end for
        python3 '${__tool_directory__}/peaktable_plot_aligned.py'
            --title 'Title'
            --raw-input-path 'files'
            --noise-threshold $noise_threshold
            --output-html '$plot'
            --cores-to-use \${GALAXY_SLOTS:-1}
            ${show_only_annotated}
            ${markers_path}
            ${intensity_path}
            ${rt_path}
            ${metadata_path}
            ${annotation_path}
    ]]></command>
    <inputs>
        <param name="input_files" type="data_collection" format="mzml" collection_type="list" label="Input files" help="TODO" />
        <param name="noise_threshold" type="integer" min="0" value="1000" label="Noise threshold" help="TODO" />
        <param argument="--show-only-annotated" type="boolean" truevalue="--show-only-annotated" falsevalue="" checked="false" label="Show only annotated features" help="TODO" />
        <param argument="--markers-path" type="data" format="tsv,tabular" label="Markers / transition list" help="TODO" />
        <param argument="--intensity-path" type="data" format="parquet,csv" label="Aligned intensity table / data matrix" help="TODO" />
        <param argument="--rt-path" type="data" format="parquet,csv" label="Aligned retention time table" help="TODO" />
        <param argument="--metadata-path" type="data" format="parquet,csv" label="Variable metadata table" help="TODO" />
        <param argument="--annotation-path" type="data" format="tabular,tsv,csv" label="Annotation table" help="TODO" />
    </inputs>
    <outputs>
        <data name="plot" format="html" label="${tool.name} on ${on_string}" />
    </outputs>
