<tool id="scipy_correlation_testing" name="scipy correlation testing" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="20.01" license="MIT">
    <description>permutation-based empirical null for selecting a correlation r-value threshold in dilution-series metabolomics data</description>
    <macros>
        <token name="@TOOL_VERSION@">1.18</token>
        <token name="@VERSION_SUFFIX@">0</token>
    </macros>
    <!-- TODO: please annotate this tool with topics and operations from http://edamontology.org -->
    <!-- TODO: for more information see: https://galaxy-iuc-standards.readthedocs.io/en/latest/best_practices/tool_xml.html#edam-topics-and-operations -->
    <edam_topics>
        <edam_topic>topic_TODO</edam_topic>
    </edam_topics>
    <edam_operations>
        <edam_operation>operation_TODO</edam_operation>
    </edam_operations>
    <xrefs>
        <xref type="bio.tools"></xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">scipy</requirement>
        <requirement type="package" version="2.5">numpy</requirement>
        <requirement type="package" version="3.0">pandas</requirement>
        <requirement type="package" version="3.11">matplotlib</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        mkdir -p features &&
        ln -s '${input}' '${input}.${input.ext}' &&
        python3 '${__tool_directory__}/area-dilution_correlation_pipeline.py' 
            --input '${input}.${input.ext}' 
            --id-col ${id_col}
            --correlation-type '${correlation_type}' 
            --target-fdr ${target_fdr}
            --n-permutations ${n_permutations}
            --seed ${seed} 
            --results-dir 'features' 
            --plot 'plot.png'
    ]]></command>
    <inputs>
        <param argument="--input" type="data" format="tsv,tabular" label="Intensity matrix input file." help="TODO" />
        <param argument="--id-col" type="data_column" data_ref="input" use_header_names="true"/>
        <param argument="--correlation-type" type="select" label="Correlation method" help="Select the correlation method to use.">
            <option value="pearson" selected="true">Pearson</option>
            <option value="spearman">Spearman</option>
        </param>
        <param argument="--target-fdr" type="float" min="0" max="1" value="0.05" label="Target FDR" help="Target empirical false discovery rate for threshold selection." />
        <param argument="--n-permutations" type="integer" min="0" max="10000" value="1000" label="Permutations" help="Number of random permutations to generate the null distribution." />
        <param argument="--seed" type="integer" value="0" label="Seed" help="Random seed for permutation sampling." />
    </inputs>
    <outputs>
        <data name="plot" format="png" from_work_dir="plot.png" label="Plot of ${tool.name} on ${on_string}" />
        <!-- TODO: creating dynamic outputs with collections is covered in depth in the planemo documentation at https://planemo.readthedocs.io/en/latest/writing_advanced.html#collections -->
        <collection name="features" type="list" label="${tool.name} on ${on_string}" format_source="input">
            <discover_datasets pattern="__name_and_ext__" directory="features" />
        </collection>
    </outputs>
    <tests>
        <!-- Hint: You can use [ctrl+alt+t] after defining the inputs/outputs to auto-scaffold some basic test cases. -->
    </tests>
