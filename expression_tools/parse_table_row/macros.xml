        <expand macro="typed_output" slot="5" type="text"/>
        <expand macro="typed_output" slot="6" type="text"/>
        <expand macro="typed_output" slot="7" type="text"/>
        <expand macro="typed_output" slot="8" type="text"/>
        <expand macro="typed_output" slot="9" type="text"/>
        <expand macro="typed_output" slot="0" type="boolean"/>
        <expand macro="typed_output" slot="1" type="boolean"/>
        <expand macro="typed_output" slot="2" type="boolean"/>
        <expand macro="typed_output" slot="3" type="boolean"/>
        <expand macro="typed_output" slot="4" type="boolean"/>
        <expand macro="typed_output" slot="5" type="boolean"/>
