        <expand macro="typed_output" slot="4" n="5" type="boolean"/>
        <expand macro="typed_output" slot="5" n="6" type="boolean"/>
        <expand macro="typed_output" slot="6" n="7" type="boolean"/>
        <expand macro="typed_output" slot="7" n="8" type="boolean"/>
        <expand macro="typed_output" slot="8" n="9" type="boolean"/>
        <expand macro="typed_output" slot="9" n="10" type="boolean"/>
    </xml>

    <xml name="annotations">
        <edam_operations>
            <edam_operation>operation_1812</edam_operation>
