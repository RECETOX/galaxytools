<macros>
    <token name="@TOOL_VERSION@">0.1.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <!-- Number of value slots the tool can produce. Must match MAX_SLOTS in
         the expression and the number of typed_output expands below. -->
    <token name="@MAX_SLOTS@">10</token>

    <!--
      One output per (slot, type) pair. Exactly one output per slot may be
      active, selected by the declared type of the corresponding repeat entry.
      Galaxy requires outputs to be declared statically, so the slots are a
      fixed pool pruned with <filter>; see the tool help for the consequences.
    -->
    <xml name="typed_output" tokens="slot,type">
        <output type="@TYPE@" name="@TYPE@_@SLOT@" from="v_@SLOT@" label="$columns[@SLOT@]['column_name']">
            <filter>len(columns) > @SLOT@ and columns[@SLOT@]['column_type'] == '@TYPE@'</filter>
        </output>
    </xml>

    <!-- Slot pool: keep these <expand> lists in sync with @MAX_SLOTS@ below. -->
    <xml name="typed_outputs">
        <expand macro="typed_output" slot="0" type="float"/>
        <expand macro="typed_output" slot="1" type="float"/>
        <expand macro="typed_output" slot="2" type="float"/>
        <expand macro="typed_output" slot="3" type="float"/>
        <expand macro="typed_output" slot="4" type="float"/>
        <expand macro="typed_output" slot="5" type="float"/>
        <expand macro="typed_output" slot="6" type="float"/>
        <expand macro="typed_output" slot="7" type="float"/>
        <expand macro="typed_output" slot="8" type="float"/>
        <expand macro="typed_output" slot="9" type="float"/>
        <expand macro="typed_output" slot="0" type="integer"/>
        <expand macro="typed_output" slot="1" type="integer"/>
        <expand macro="typed_output" slot="2" type="integer"/>
        <expand macro="typed_output" slot="3" type="integer"/>
        <expand macro="typed_output" slot="4" type="integer"/>
        <expand macro="typed_output" slot="5" type="integer"/>
        <expand macro="typed_output" slot="6" type="integer"/>
        <expand macro="typed_output" slot="7" type="integer"/>
        <expand macro="typed_output" slot="8" type="integer"/>
        <expand macro="typed_output" slot="9" type="integer"/>
        <expand macro="typed_output" slot="0" type="text"/>
        <expand macro="typed_output" slot="1" type="text"/>
        <expand macro="typed_output" slot="2" type="text"/>
        <expand macro="typed_output" slot="3" type="text"/>
